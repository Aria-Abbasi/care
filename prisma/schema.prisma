datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

model User {
  id           String         @id @default(cuid())
  username     String         @unique
  passwordHash String
  fullName     String
  role         String         // ADMIN, NURSE
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  taskLogs      TaskLog[]
  vitalLogs     VitalLog[]
  clinicalNotes ClinicalNote[]
}

model Medication {
  id                String     @id @default(cuid())
  nameFa            String
  nameEn            String?
  dosage            String?
  unit              String?
  boxNumber         String?    // کد دارو — auto-generated, written on the box, shown before the name everywhere
  instructions      String?    // legacy: per-prescription instructions now live on Prescription.notes
  doctorName        String?    // legacy: prescribing doctor now lives on Prescription.doctorName
  stockCount        Int        @default(0) // only increased through the purchase (restock) form
  lowStockThreshold Int        @default(15)
  timeConstraints   String?    // تداخل دارویی (drug interactions)
  isActive          Boolean    @default(true)
  discontinuedAt    DateTime?
  discontinuedReason String?
  discontinuedBy    String?
  replacedById      String?
  doctorOrderNotes  String?    // توضیحات اختصاصی دارو (fixed, not prescription-specific)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  schedules     Schedule[]
  history       MedicationHistory[]
  prescriptions Prescription[]
}

// ثبت فعالیت دارو — a doctor's prescription for a medication (one medication may have many over time)
model Prescription {
  id           String     @id @default(cuid())
  medicationId String
  medication   Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  doctorName   String?
  prescribedAt DateTime   @default(now())
  notes        String?
  isActive     Boolean    @default(true)
  endedAt      DateTime?
  endedReason  String?
  createdBy    String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  schedules Schedule[]

  @@index([medicationId])
}

model MedicationHistory {
  id             String      @id @default(cuid())
  medicationId   String?
  medication     Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  medicationName String
  actionType     String      // CREATED, SCHEDULE_CHANGED, STOPPED, REACTIVATED
  description    String      // Full Persian human-readable narrative
  reason         String?     // Discontinuation or change reason
  doctorName     String?     // Doctor or practitioner name
  performedBy    String?     // User or admin who performed the change
  detailsJson    String?     // Structured metadata
  createdAt      DateTime    @default(now())

  @@index([medicationId])
  @@index([createdAt])
}

model Schedule {
  id            String      @id @default(cuid())
  itemType      String      // medication, routine_task, meal, dvt_care
  title         String
  targetTime    String      // HH:mm (e.g. 07:00)
  category      String      // medication, meal, dvt_care, routine
  daysOfWeek    String?     @default("ALL") // ALL or comma-separated days
  mealRelation  String?     // FASTING, BEFORE_MEAL, WITH_MEAL, AFTER_MEAL, BEDTIME
  startDate     DateTime?
  intervalUnit  String?     @default("DAYS") // ONCE, HOURS, DAYS, WEEKS
  intervalValue Int?        @default(1)
  endDate       DateTime?
  requiresNote  Boolean     @default(false)
  vitalType     String?     // blood_sugar, blood_pressure, urine_output, water_intake, dvt_care, bowel_movement, clinical_photo
  rulesJson     String?
  medicationId  String?
  medication    Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)
  prescriptionId String?
  prescription  Prescription? @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  taskLogs TaskLog[]
}

model TaskLog {
  id          String    @id @default(cuid())
  scheduleId  String?
  schedule    Schedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  taskTitle   String
  nurseId     String
  nurse       User      @relation(fields: [nurseId], references: [id])
  completedAt DateTime  @default(now())
  status      String    @default("DONE") // DONE, SKIPPED, REFUSED
  notes       String?
  createdAt   DateTime  @default(now())

  @@index([completedAt])
  @@index([nurseId])
}

model VitalLog {
  id            String   @id @default(cuid())
  nurseId       String
  nurse         User     @relation(fields: [nurseId], references: [id])
  recordedAt    DateTime @default(now())
  type          String   // blood_sugar, blood_pressure, water_intake, urine_output, bowel_movement, dvt_timer, dvt_measurement, laxative, weight, mobility, food_log
  valueNum      Float?
  valueText     String?
  systolic      Int?
  diastolic     Int?
  mealTag       String?  // fasting, 2h_breakfast, before_lunch, 2h_lunch, before_dinner, 2h_dinner, random
  bowelGrade    String?  // partial, 1_plus, 2_plus, 3_plus
  laxativeGiven String?
  extraData     String?
  createdAt     DateTime @default(now())

  @@index([recordedAt])
  @@index([type])
  @@index([nurseId])
}

model ClinicalNote {
  id        String   @id @default(cuid())
  nurseId   String
  nurse     User     @relation(fields: [nurseId], references: [id])
  createdAt DateTime @default(now())
  category  String   // dvt_leg, nails, skin_wound, incident, pain, general
  noteText  String
  photoUrl  String?

  @@index([createdAt])
  @@index([category])
}

model DietRecipe {
  id           String   @id @default(cuid())
  mealType     String   // LUNCH, DINNER, SNACK
  title        String
  description  String?
  instructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SmoothieRecipe {
  id           String   @id @default(cuid())
  title        String
  ingredients  String
  instructions String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PatientProfile {
  id               String   @id @default(cuid())
  fullName         String   @default("آقای جواد یزدانی")
  age              Int?     @default(78)
  bloodType        String?  @default("A+")
  notes            String?  @default("سابقه DVT پای راست، دیابت تحت کنترل، مصرف رقیق‌کننده خون (آپیکسابان)")
  emergencyContact String?  @default("۰۹۱۲۰۰۰۰۰۰۰")
  updatedAt        DateTime @updatedAt
}

model AdhocSuggestion {
  id           String   @id @default(cuid())
  title        String   @unique
  category     String?  @default("مراقبتی") // vital, medication, meal, routine (legacy Persian categories are still supported)
  vitalType    String?  // blood_sugar, blood_pressure, urine_output, water_intake, dvt_care, bowel_movement, laxative, clinical_photo
  medicationId String?  // medication to deduct from stock when the nurse performs this activity
  mealRelation String?  // selected recipe reference / meal relation for meal activities
  requiresNote Boolean  @default(false)
  defaultNotes String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model MealTimeSlot {
  id          String   @id @default(cuid())
  name        String   @unique
  labelFa     String
  defaultTime String
  isActive    Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ActiveTimer {
  id         String   @id @default(cuid())
  timerType  String   // dvt_care
  startTime  DateTime
  scheduleId String?
  taskTitle  String?  @default("مراقبت DVT پای راست")
  nurseId    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}


